    {
      "id": 17,
      "type": "row",
      "title": "Click pipeline (redirect → JetStream → analytics)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "panels": []
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Clicks/s at each stage",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(shorty_clicks_enqueued_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "1 enqueued (redirect)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(shorty_clicks_published_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "2 acked by JetStream",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(shorty_analytics_events_total{namespace=~\"$namespace\", result=\"processed\"}[$__rate_interval]))",
          "legendFormat": "3 aggregated (analytics)",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(shorty_clicks_dropped_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "dropped",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": ""
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Backlog: redirect buffers + consumer lag; freshness",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(shorty_clicks_buffer_depth{namespace=~\"$namespace\"})",
          "legendFormat": "redirect buffers",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(shorty_analytics_consumer_pending{namespace=~\"$namespace\"}) + max(shorty_analytics_consumer_ack_pending{namespace=~\"$namespace\"})",
          "legendFormat": "consumer lag",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(shorty_analytics_last_event_age_seconds{namespace=~\"$namespace\"})",
          "legendFormat": "freshness (s)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
