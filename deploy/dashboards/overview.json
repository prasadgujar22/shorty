      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(kube_pod_status_ready{namespace=~\"$namespace\", condition=\"true\", pod=~\"redirect-svc-.*\"})",
